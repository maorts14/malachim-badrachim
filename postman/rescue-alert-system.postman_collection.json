    {
      "name": "Device Registration",
      "description": "Register a mobile device for push notifications. This endpoint requires the same Django JWT Bearer token as the rest of the API.\n\nIt supports multiple devices per user, platform tagging, and upserts on re-registration: the same authenticated Django user and `device_id` update the stored `push_token`.",
      "item": [
        {
          "name": "Register / Update Device",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"push_token\": \"<push_notification_token>\",\n  \"device_id\": \"unique-device-identifier\",\n  \"platform\": \"android\",\n  \"device_model\": \"Samsung Galaxy S24\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/notifications/token",
              "host": ["{{base_url}}"],
              "path": ["api", "notifications", "token"]
            },
            "description": "Register or update a device for push notifications.\n\n**Required fields:** `push_token`, `device_id`, `platform`\n\n**platform options:** `android`, `ios`, `other`\n\n**device_model:** Optional. Human-readable device name.\n\nIf the same `device_id` is already registered for the authenticated Django user, its `push_token` is updated. Returns 204 on success."
          },
          "response": [
            {
              "name": "204 No Content — registered or updated",
              "status": "No Content",
              "code": 204,
              "body": ""
            },
            {
              "name": "400 Bad Request — missing required fields",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"push_token\": [\"This field is required.\"],\n  \"device_id\": [\"This field is required.\"],\n  \"platform\": [\"This field is required.\"]\n}"
            },
            {
              "name": "401 Unauthorized — invalid or missing token",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"error\": \"Unauthorized\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Notifications (Legacy)",
      "description": "Simple push notification token store. One token per record, not per device.\n\n**Prefer Device Registration** for new integrations — it supports multi-device per user and FCM upsert.\n\n`user` is set automatically from the authenticated token and is read-only.",
      "item": [
        {
          "name": "List Notification Tokens",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/notification/",
              "host": ["{{base_url}}"],
              "path": ["api", "notification", ""]
            },
            "description": "Returns all registered notification token records."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"id\": 1,\n    \"user\": 1,\n    \"token\": \"<fcm_token_string>\"\n  }\n]"
            }
          ]
        },
        {
          "name": "Register Notification Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<fcm_token_string>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/notification/",
              "host": ["{{base_url}}"],
              "path": ["api", "notification", ""]
            },
            "description": "Register a push notification token. `user` is set from the token. Tokens must be globally unique — re-registering the same token returns 400."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"id\": 1,\n  \"user\": 1,\n  \"token\": \"<fcm_token_string>\"\n}"
            },
            {
              "name": "400 — duplicate token",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"token\": [\"notification with this token already exists.\"]\n}"
            }
          ]
        },
        {
          "name": "Get Notification Token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/notification/{{notification_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "notification", "{{notification_id}}", ""]
            },
            "description": "Retrieve a single notification token record by ID."
          }
        },
        {
          "name": "Update Notification Token",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<new_fcm_token_string>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/notification/{{notification_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "notification", "{{notification_id}}", ""]
            },
            "description": "Update a notification token record with a new FCM token."
          }
        },
        {
          "name": "Delete Notification Token",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/notification/{{notification_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "notification", "{{notification_id}}", ""]
            },
            "description": "Remove a notification token record."
          },
          "response": [
            {
              "name": "204 No Content",
              "status": "No Content",
              "code": 204,
              "body": ""
            }
          ]
        }
      ]
    }
  ]
