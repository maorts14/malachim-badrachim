  "item": [
    {
      "name": "Authentication",
      "description": "Django SimpleJWT authentication. Run **Register** for a new account or **Login (Obtain Tokens)** for an existing account. Both save `access_token` and `refresh_token`; all other folders inherit the access token.\n\nUse **Verify Current Token** to confirm authentication before testing another endpoint, and **Refresh Access Token** when needed.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.access && r.refresh) {",
                  "    pm.collectionVariables.set('access_token', r.access);",
                  "    pm.collectionVariables.set('refresh_token', r.refresh);",
                  "    console.log('Django JWT token pair saved.');",
                  "} else {",
                  "    console.error('Registration failed:', JSON.stringify(r));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"full_name\": \"Example Responder\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register", ""]
            },
            "description": "Creates a Django user and profile through `POST /api/auth/register/`. On success, the test script saves the returned SimpleJWT access and refresh tokens for all subsequent requests. `full_name` and `invite_code` are optional."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"access\": \"<jwt_access_token>\",\n  \"refresh\": \"<jwt_refresh_token>\",\n  \"user\": {\n    \"id\": 42,\n    \"username\": \"user@example.com\",\n    \"email\": \"user@example.com\",\n    \"name\": \"Example Responder\",\n    \"role\": \"user\",\n    \"is_staff\": false\n  }\n}"
            },
            {
              "name": "400 Duplicate or invalid registration",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"email\": [\n    \"An account with this email already exists.\"\n  ]\n}"
            }
          ]
        },
        {
          "name": "Login (Obtain Tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.access && r.refresh) {",
                  "    pm.collectionVariables.set('access_token', r.access);",
                  "    pm.collectionVariables.set('refresh_token', r.refresh);",
                  "    console.log('Django JWT token pair saved.');",
                  "} else {",
                  "    console.error('Login failed:', JSON.stringify(r));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "token", ""]
            },
            "description": "Obtains a SimpleJWT access/refresh token pair from an existing Django account. The endpoint accepts the Django username; newly registered accounts use their email address as the username."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"access\": \"<jwt_access_token>\",\n  \"refresh\": \"<jwt_refresh_token>\"\n}"
            }
          ]
        },
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.access) {",
                  "    pm.collectionVariables.set('access_token', r.access);",
                  "    console.log('Django JWT access token refreshed.');",
                  "} else {",
                  "    console.error('Token refresh failed:', JSON.stringify(r));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "token", "refresh", ""]
            },
            "description": "Exchanges a valid SimpleJWT refresh token for a new access token. The test script replaces only `access_token`."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"access\": \"<new_jwt_access_token>\"\n}"
            }
          ]
        },
        {
          "name": "Verify Current Token",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/auth/whoami/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "whoami", ""]
            },
            "description": "Confirms that the collection's inherited Bearer access token is accepted by the API."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"authenticated\": true,\n  \"user\": {\n    \"id\": 42,\n    \"username\": \"user@example.com\",\n    \"email\": \"user@example.com\",\n    \"name\": \"Example Responder\",\n    \"role\": \"user\",\n    \"is_staff\": false\n  }\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Alerts",
      "description": "Create and manage rescue alerts. All requests inherit the collection Bearer token. Managers and emergency dispatchers create, update, delete, and dispatch alerts; volunteers can only respond to their own assignment.\n\n**Status values:** `OPEN` → `DISPATCHED` → `ACCEPTED` → `IN_PROGRESS` → `RESOLVED` / `CANCELLED`\n\n**Priority values:** `LOW`, `MEDIUM`, `HIGH`, `CRITICAL`\n\n**Coordinates:** `latitude` must be −90 to 90, `longitude` must be −180 to 180. Both must be provided together on updates.",
      "item": [
        {
          "name": "List Alerts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/alerts/",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", ""]
            },
            "description": "Returns all alerts ordered by newest first (`-created_at`)."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[\n  {\n    \"id\": 1,\n    \"title\": \"Fire on Main St\",\n    \"description\": \"Building fire, multiple floors\",\n    \"latitude\": 40.7128,\n    \"longitude\": -74.006,\n    \"status\": \"OPEN\",\n    \"priority\": \"CRITICAL\",\n    \"created_at\": \"2024-01-15T10:30:00Z\",\n    \"updated_at\": \"2024-01-15T10:30:00Z\"\n  }\n]"
            },
            {
              "name": "401 Unauthorized — missing or expired token",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"detail\": \"Authentication credentials were not provided.\"\n}"
            }
          ]
        },
        {
          "name": "Create Alert",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fire on Main St\",\n  \"description\": \"Building fire, multiple floors affected\",\n  \"latitude\": 40.7128,\n  \"longitude\": -74.006,\n  \"status\": \"OPEN\",\n  \"priority\": \"CRITICAL\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/alerts/",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", ""]
            },
            "description": "Create a new alert. `status` defaults to `OPEN`, `priority` defaults to `MEDIUM` if omitted."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"id\": 1,\n  \"title\": \"Fire on Main St\",\n  \"description\": \"Building fire, multiple floors affected\",\n  \"latitude\": 40.7128,\n  \"longitude\": -74.006,\n  \"status\": \"OPEN\",\n  \"priority\": \"CRITICAL\",\n  \"created_at\": \"2024-01-15T10:30:00Z\",\n  \"updated_at\": \"2024-01-15T10:30:00Z\"\n}"
            },
            {
              "name": "400 Bad Request — validation error",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"latitude\": [\"Latitude must be between -90 and 90.\"],\n  \"longitude\": [\"Longitude must be between -180 and 180.\"]\n}"
            }
          ]
        },
        {
          "name": "Get Alert",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/alerts/{{alert_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", "{{alert_id}}", ""]
            },
            "description": "Retrieve a single alert by ID."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"id\": 1,\n  \"title\": \"Fire on Main St\",\n  \"description\": \"Building fire, multiple floors affected\",\n  \"latitude\": 40.7128,\n  \"longitude\": -74.006,\n  \"status\": \"OPEN\",\n  \"priority\": \"CRITICAL\",\n  \"created_at\": \"2024-01-15T10:30:00Z\",\n  \"updated_at\": \"2024-01-15T10:30:00Z\"\n}"
