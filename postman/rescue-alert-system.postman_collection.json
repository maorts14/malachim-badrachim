    {
      "name": "Messages",
      "description": "Send and retrieve field messages. Supports text-only or text + voice file attachment.\n\nUse `alert` to make an incident-scoped operational thread, or `group` for a group thread. A volunteer can only read or post in alerts assigned to them and groups they belong to; dispatchers can coordinate across contexts.\n\n`sender` is set automatically from the authenticated token — do not include it in request bodies.\n\nVoice files are served from `/media/voices/` and accessible via the `voice_url` field in responses.",
      "item": [
        {
          "name": "List Messages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/message/",
              "host": ["{{base_url}}"],
              "path": ["api", "message", ""]
            },
            "description": "Returns messages visible to the authenticated user. Add `?alert={{alert_id}}` or `?group={{group_id}}` to retrieve one operational thread."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"id\": 1,\n    \"sender\": {\n      \"id\": 1,\n      \"username\": \"<firebase_uid>\",\n      \"email\": \"jdoe@example.com\",\n      \"role\": \"rescuer\"\n    },\n    \"title\": \"Evacuation Update\",\n    \"text\": \"Sector 3 is clear.\",\n    \"voice_file\": null,\n    \"voice_url\": null,\n    \"latitude\": 40.7128,\n    \"longitude\": -74.006,\n    \"timestamp\": \"2024-01-15T10:35:00Z\"\n  }\n]"
            }
          ]
        },
        {
          "name": "List Messages (Newest First)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/message/list_messages/",
              "host": ["{{base_url}}"],
              "path": ["api", "message", "list_messages", ""]
            },
            "description": "Returns all messages ordered by `timestamp` descending (newest first). Prefer this over the plain list endpoint."
          }
        },
        {
          "name": "Create Message (Text)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alert\": {{alert_id}},\n  \"title\": \"Evacuation Update\",\n  \"text\": \"Sector 3 is clear. All units proceed to sector 4.\",\n  \"latitude\": 40.7128,\n  \"longitude\": -74.006\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/message/",
              "host": ["{{base_url}}"],
              "path": ["api", "message", ""]
            },
            "description": "Create a text message in the selected alert context. Use either optional `alert` or `group` when creating a contextual thread; `text`, `latitude`, and `longitude` are optional. `sender` is set from the token."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"id\": 1,\n  \"sender\": {\n    \"id\": 1,\n    \"username\": \"<firebase_uid>\",\n    \"email\": \"jdoe@example.com\",\n    \"role\": \"rescuer\"\n  },\n  \"title\": \"Evacuation Update\",\n  \"text\": \"Sector 3 is clear. All units proceed to sector 4.\",\n  \"voice_file\": null,\n  \"voice_url\": null,\n  \"latitude\": 40.7128,\n  \"longitude\": -74.006,\n  \"timestamp\": \"2024-01-15T10:35:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Create Message (With Voice)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Voice Update", "type": "text" },
                { "key": "text", "value": "See attached audio.", "type": "text", "description": "Optional" },
                { "key": "latitude", "value": "40.7128", "type": "text", "description": "Optional" },
                { "key": "longitude", "value": "-74.006", "type": "text", "description": "Optional" },
                { "key": "voice_file", "type": "file", "src": "", "description": "Audio file (mp3, wav, m4a, etc.)" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/message/",
              "host": ["{{base_url}}"],
              "path": ["api", "message", ""]
            },
            "description": "Create a message with a voice file attachment. Use `multipart/form-data` — **do not set `Content-Type` manually**, Postman adds the boundary automatically. The response includes `voice_url` pointing to the uploaded file under `/media/voices/`."
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"id\": 2,\n  \"sender\": {\n    \"id\": 1,\n    \"username\": \"<firebase_uid>\",\n    \"email\": \"jdoe@example.com\",\n    \"role\": \"rescuer\"\n  },\n  \"title\": \"Voice Update\",\n  \"text\": \"See attached audio.\",\n  \"voice_file\": \"voices/update.mp3\",\n  \"voice_url\": \"https://rescue-alert-system-malachim-badrachim.navonsimon.com/media/voices/update.mp3\",\n  \"latitude\": 40.7128,\n  \"longitude\": -74.006,\n  \"timestamp\": \"2024-01-15T10:36:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Get Message",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/message/{{message_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "message", "{{message_id}}", ""]
            },
            "description": "Retrieve a single message by ID."
          }
        },
        {
          "name": "Update Message (Full)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Evacuation Update\",\n  \"text\": \"Updated: Sector 3 and 4 are clear.\",\n  \"latitude\": 40.7128,\n  \"longitude\": -74.006\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/message/{{message_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "message", "{{message_id}}", ""]
            },
            "description": "Replace all writable fields on a message. `sender` and `timestamp` are read-only and ignored."
          }
        },
        {
          "name": "Update Message (Partial)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Updated message content.\"\n}"
