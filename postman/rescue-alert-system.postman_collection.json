            "description": "Update one or more fields. If updating coordinates, `latitude` and `longitude` must both be present — providing only one returns a 400."
          },
          "response": [
            {
              "name": "400 — partial coordinate update rejected",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"non_fields_error\": [\"Both latitude and longitude must be provided together.\"]\n}"
            }
          ]
        },
        {
          "name": "Delete Alert",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/alerts/{{alert_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", "{{alert_id}}", ""]
            },
            "description": "Permanently delete an alert."
          },
          "response": [
            {
              "name": "204 No Content",
              "status": "No Content",
              "code": 204,
              "body": ""
            }
          ]
        },
        {
          "name": "Dispatch Alert",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"user_ids\": [2, 3]\n}" },
            "url": { "raw": "{{base_url}}/api/alerts/{{alert_id}}/dispatch/", "host": ["{{base_url}}"], "path": ["api", "alerts", "{{alert_id}}", "dispatch", ""] },
            "description": "Dispatcher-only. Assign one or more volunteer user IDs and send them a best-effort FCM notification."
          }
        },
        {
          "name": "Respond to Alert Assignment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"response\": \"accept\"\n}" },
            "url": { "raw": "{{base_url}}/api/alerts/{{alert_id}}/respond/", "host": ["{{base_url}}"], "path": ["api", "alerts", "{{alert_id}}", "respond", ""] },
            "description": "Assigned volunteer only. Valid responses are `accept`, `decline`, and `arrive`; arrival requires prior acceptance."
          }
        },
        {
          "name": "Get Nearby Alerts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/alerts/nearby/?lat=40.7128&lon=-74.006&radius=5000",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", "nearby", ""],
              "query": [
                { "key": "lat", "value": "40.7128", "description": "Latitude of center point (float, required)" },
                { "key": "lon", "value": "-74.006", "description": "Longitude of center point (float, required)" },
                { "key": "radius", "value": "5000", "description": "Search radius in meters (integer, required)" }
              ]
            },
            "description": "Returns operational alerts within `radius` meters of the given coordinates using the database spatial distance query. All three query params are required."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "[\n  {\n    \"id\": 1,\n    \"title\": \"Fire on Main St\",\n    \"description\": \"Building fire\",\n    \"latitude\": 40.7128,\n    \"longitude\": -74.006,\n    \"status\": \"OPEN\",\n    \"priority\": \"CRITICAL\",\n    \"created_at\": \"2024-01-15T10:30:00Z\",\n    \"updated_at\": \"2024-01-15T10:30:00Z\"\n  }\n]"
            },
            {
              "name": "400 — missing params",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"error\": \"lat, lon, and radius query parameters are required\"\n}"
            },
            {
              "name": "400 — invalid param types",
              "status": "Bad Request",
              "code": 400,
              "body": "{\n  \"error\": \"lat and lon must be floats, radius must be an integer\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "User Profiles",
      "description": "Manage user profiles and locations. Create Django accounts with `POST /api/auth/register/`, then authenticate with a Django JWT.\n\n**Role values:** `user` (volunteer, default), `emergency_dispatcher`, `manager`. Only managers can change roles or administer profiles.\n\nProfile fields exposed: `id` (profile ID), `user_id` (Django account ID required by alert dispatch), `username` (the Django username), `email`, `display_name`, `phone`, `role`, `latitude`, `longitude`.",
      "item": [
