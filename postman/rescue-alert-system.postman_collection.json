            "url": {
              "raw": "{{base_url}}/api/message/{{message_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "message", "{{message_id}}", ""]
            },
            "description": "Partially update a message."
          }
        },
        {
          "name": "Delete Message",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/message/{{message_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "message", "{{message_id}}", ""]
            },
            "description": "Permanently delete a message and its associated voice file."
